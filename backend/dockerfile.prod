FROM php:8.2-fpm

WORKDIR /var/www/html

# Instalar dependencias incluyendo Nginx
RUN apt-get update && apt-get install -y \
    git \
    zip \
    unzip \
    libzip-dev \
    libonig-dev \
    nginx \
    && docker-php-ext-install pdo_mysql mbstring zip

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Copiar el código fuente
COPY . .

# Instalar dependencias (sin dev) y optimizar
RUN composer install --no-dev --optimize-autoloader

# Cachear rutas y config
RUN php artisan route:cache && php artisan config:cache

# Ajustar permisos
RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Copiar configuración de Nginx
COPY nginx.conf /etc/nginx/sites-enabled/default

# Exponer el puerto 80 para Nginx
EXPOSE 80

# Script para iniciar Nginx y PHP-FPM
RUN echo "service nginx start && php-fpm" > /start.sh && chmod +x /start.sh

CMD ["/start.sh"]